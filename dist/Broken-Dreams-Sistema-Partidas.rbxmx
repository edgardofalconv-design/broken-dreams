        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">MapRegistry</string>
            <string name="Source"><![CDATA[-- Solo se usan modelos YA EXISTENTES con BDMapId y RoundSpawns completos.
-- No se generan mapas. Imagen vacía hasta recibir un recurso auténtico.
return {
 {Id="round_test", Name="Arena provisional · SOLO PRUEBAS", Image="", Enabled=true, StudioOnly=true},
 {Id="forgotten_glade", Name="The Forgotten Glade", Image="", Enabled=true},
 {Id="rotten_swamp", Name="The Rotten Swamp", Image="", Enabled=false},
 {Id="dead_fiesta", Name="The Dead Fiesta", Image="", Enabled=false},
 {Id="sunken_facility", Name="The Sunken Facility", Image="", Enabled=false},
 {Id="fallen_olympus", Name="The Fallen Olympus", Image="", Enabled=false},
}
]]></string>
          </Properties>
