            <string name="Source"><![CDATA[return {
 Order = {"Rayman", "Globox", "Grand Minimus", "Barbara", "Murfy", "Ly"},
 Survivors = {
  Rayman={ModelName="", LMSMusicId="", LMSTitle="THE LAST DREAM"},
  Globox={ModelName="", LMSMusicId="", LMSTitle=""},
  ["Grand Minimus"]={ModelName="", LMSMusicId="", LMSTitle=""},
  Barbara={ModelName="", LMSMusicId="", LMSTitle=""},
  Murfy={ModelName="", LMSMusicId="", LMSTitle=""},
  Ly={ModelName="", LMSMusicId="", LMSTitle=""},
 },
 Killer={Name="RAY.X", ModelName=""},
}
]]></string>
