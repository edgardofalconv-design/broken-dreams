  <Item class="ServerScriptService" referent="5730">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="5731">
      <Properties>
        <string name="Name">BrokenDreamsLobbyAPI</string>
        <string name="Source"><![CDATA[-- API exclusiva del servidor. No inicia partidas ni asigna asesino.
local state=game:GetService("ReplicatedStorage"):WaitForChild("BrokenDreamsLobbyState")
local API={}
local function imageId(value)
 assert(type(value)=="string" and (value=="" or value:match("^rbxassetid://%d+$")), "Usa rbxassetid://ID o una cadena vacía")
 return value
end
function API.SetCountdown(seconds)
 assert(type(seconds)=="number" and seconds==seconds and seconds<math.huge and (seconds==-1 or seconds>=0),"Tiempo inválido")
 state:SetAttribute("RemainingSeconds",seconds==-1 and -1 or math.floor(seconds))
end
function API.SetNextMap(name,asset)
 assert(type(name)=="string","Nombre inválido")
 local checked=imageId(asset)
 state:SetAttribute("NextMapImage",checked);state:SetAttribute("NextMapName",name)
end
function API.SetPortrait(characterName,asset)
 local portraits=state:FindFirstChild("Portraits")
 characterName=characterName:gsub(" ","_")
 assert(portraits:GetAttribute(characterName)~=nil,"Superviviente desconocido")
 portraits:SetAttribute(characterName,imageId(asset))
end
-- Mayor malicia obligatoria. Empate: menor UserId; nunca se usa azar.
-- Devuelve nil si faltan datos: nunca escoge arbitrariamente por defecto.
function API.GetHighestMalice(players,readMalice)
 assert(type(readMalice)=="function","Proporciona la función que lee tu malicia autoritativa")
 local best,bestValue=nil,-math.huge
 for _,player in ipairs(players) do
  local value=readMalice(player)
  if type(value)~="number" or value~=value or math.abs(value)==math.huge then
   return nil,"Malicia no disponible para "..player.Name
  end
  if value>bestValue or (value==bestValue and (not best or player.UserId<best.UserId)) then best=player;bestValue=value end
 end
 return best,bestValue
end
function API.RefreshMalicia(players,readMalice)
 local player,value=API.GetHighestMalice(players,readMalice)
 if not player then
  state:SetAttribute("MaliciaUserId",0);state:SetAttribute("MaliciaName","POR DETERMINAR");state:SetAttribute("MaliciaValue",0)
  return nil,value
 end
 state:SetAttribute("MaliciaValue",value);state:SetAttribute("MaliciaName",player.DisplayName);state:SetAttribute("MaliciaUserId",player.UserId)
 return player,value
end
return API
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="5732">
      <Properties>
        <string name="Name">BrokenDreamsLobbyServer</string>
        <string name="Source"><![CDATA[local Players=game:GetService("Players")
local state=game:GetService("ReplicatedStorage"):WaitForChild("BrokenDreamsLobbyState")
local lobby=workspace:WaitForChild("BrokenDreamsLobby")
local portraits=state:WaitForChild("Portraits")
local function guiFor(model)
 local surface=model:FindFirstChild("DisplaySurface",true)
 return surface and surface:FindFirstChild("Display")
end
local malicia=guiFor(lobby.MaliciaBoard)
local map=guiFor(lobby.NextMapBoard)
local requestVersion=0
local function updateMalicia()
 requestVersion+=1;local thisRequest=requestVersion
 malicia.Detail.Text=state:GetAttribute("MaliciaName") or "POR DETERMINAR"
 malicia.Portrait.Image="";malicia.Placeholder.Visible=true
 local id=state:GetAttribute("MaliciaUserId") or 0
 if id>0 then
  task.spawn(function()
   local ok,image,ready=pcall(Players.GetUserThumbnailAsync,Players,id,Enum.ThumbnailType.AvatarBust,Enum.ThumbnailSize.Size420x420)
   if ok and ready and requestVersion==thisRequest then malicia.Portrait.Image=image;malicia.Placeholder.Visible=false end
  end)
 end
end
local function updateMap()
 map.Detail.Text=state:GetAttribute("NextMapName") or "MAPA PENDIENTE"
 map.Portrait.Image=state:GetAttribute("NextMapImage") or ""
 map.Placeholder.Visible=map.Portrait.Image==""
end
for _,key in ipairs({"MaliciaName","MaliciaUserId"}) do state:GetAttributeChangedSignal(key):Connect(updateMalicia) end
for _,key in ipairs({"NextMapName","NextMapImage"}) do state:GetAttributeChangedSignal(key):Connect(updateMap) end
updateMap();updateMalicia()
for _,model in ipairs(lobby.CharacterGallery:GetChildren()) do
 local display=guiFor(model)
 if display then
  local name=model:GetAttribute("CharacterName"):gsub(" ","_")
  local function refresh() display.Portrait.Image=portraits:GetAttribute(name) or "";display.Placeholder.Visible=display.Portrait.Image=="" end
  portraits:GetAttributeChangedSignal(name):Connect(refresh);refresh()
 end
end
local function joined(player)
 if state:GetAttribute("AssignLobbySpawn") then player.RespawnLocation=lobby.PlayerSpawns.LobbySpawn end
end
Players.PlayerAdded:Connect(joined)
for _,player in ipairs(Players:GetPlayers()) do joined(player) end
-- No bucle de cuenta atrás: el futuro RoundService llamará a API.SetCountdown.
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="5733">
      <Properties>
        <string name="Name">BrokenDreams</string>
      </Properties>
      <Item class="Script" referent="5734">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ServerStorage=game:GetService("ServerStorage")
local RunService=game:GetService("RunService")
local root=ReplicatedStorage:WaitForChild("BrokenDreams")
local shared=root:WaitForChild("Shared")
local config=require(shared.GameConfig)
local registry=require(shared.CharacterRegistry)
local mapRegistry=require(shared.MapRegistry)
local runtime=root:WaitForChild("RoundState")
if runtime:GetAttribute("Running") then warn("[BROKEN DREAMS] Controlador duplicado rechazado");return end
runtime:SetAttribute("Running",true)
local remotes=root.Remotes
local lobby=workspace:WaitForChild("BrokenDreamsLobby",10)
local lobbyState=ReplicatedStorage:FindFirstChild("BrokenDreamsLobbyState")
if not lobby or not lobbyState then runtime:SetAttribute("Running",false);warn("[BROKEN DREAMS] Falta el lobby original; no se ha creado uno nuevo");return end
local API=require(game:GetService("ServerScriptService"):WaitForChild("BrokenDreamsLobbyAPI"))
local random=Random.new()
local Core=require(script.Parent.RoundCore)
local core=Core.new(config,registry.Order,function(n)return random:NextInteger(1,n)end)
local hooks=require(script.Parent.IntegrationHooks)
local malicia=require(script.Parent.MaliciaService).new(config,hooks)
local avatar=require(script.Parent.AvatarService).new(config,registry)
local spawn=require(script.Parent.SpawnService).new(config,lobby)
local maps=require(script.Parent.MapService).new(mapRegistry,spawn,config,lobby)
local revive=require(script.Parent.ReviveService).new(core,config,Players)
local escape=require(script.Parent.EscapeService).new(core,Players)
local results=require(script.Parent.ResultsService).new(hooks)
local limiter=require(script.Parent.RateLimiter).new(8,4)
local candidate=nil;local diagnostic="";local retryAt=0
local preparing=false;local returning=false;local controlledLoads={};local recovery={};local outReturned={};local playerConnections={}
local lastState="";local lastRound=0;local publishAt=0;local lastBoard="";local lastWarning=""
local health
local function now() return workspace:GetServerTimeNow() end
local function present(player) return player.Parent==Players end
local function participantList()
 local list={}
 for _,player in Players:GetPlayers() do
  local ok,value=pcall(malicia.Get,malicia,player)
  if ok then
   table.insert(list,{id=player.UserId,name=player.DisplayName,malicia=value})
   player:SetAttribute("BDMalicia",value)
  elseif lastWarning~=tostring(value) then lastWarning=tostring(value);warn("[BROKEN DREAMS] "..lastWarning) end
 end
 return list
end
-- Bindables exclusivos del servidor. No se abre un remote administrativo al cliente.
local function countdownRoster()
 local list={}
 for _,player in Players:GetPlayers() do table.insert(list,{id=player.UserId,name=player.DisplayName}) end
 return list -- La cuenta depende de jugadores conectados, no de la carga de sus datos de Malicia.
end
local signals=Instance.new("Folder");signals.Name="Signals";signals.Parent=script.Parent
local startRequested=Instance.new("BindableEvent");startRequested.Name="RoundStartRequested";startRequested.Parent=signals
local restartCountdown=Instance.new("BindableFunction");restartCountdown.Name="RestartLobbyCountdown";restartCountdown.Parent=signals
restartCountdown.OnInvoke=function()
 local ok=core:RestartLobbyCountdown(now(),countdownRoster())
 if ok then publishAt=0 end
 return ok
end
local function loadAvatar(player,record)
 controlledLoads[player.UserId]=true
 local ok,err=avatar:Load(player,record)
 controlledLoads[player.UserId]=nil
 return ok,err
end
local function resetAttributes(player)
 for _,name in {"BDHealth","BDLives","BDStatus","BDRole","BDCharacter","BDResult"} do player:SetAttribute(name,nil) end
end
local function moveLobby(player,index)
 if not present(player) then return end
 spawn:Teleport(player,spawn:LobbyCFrame(index))
 player.RespawnLocation=lobby.PlayerSpawns.LobbySpawn
end
local function recoverCharacter(player,cf)
 local id=player.UserId;local p=core.roster[id]
 if recovery[id] or not p or not core:IsActive() then return end
 recovery[id]=true
 local round=core.roundId
 -- Reset/muerte ambiental no concede segundos al asesino.
 if p.role=="KILLER" then
  core:Finish(now(),"KILLER_LEFT")
 elseif p.status=="ALIVE" then core:Damage(id,p.health,nil,now()) end
 task.spawn(function()
  health:Unbind(id)
  local ok=loadAvatar(player,p)
  if ok and core.roundId==round and core:IsActive() and (p.status=="ALIVE" or p.status=="DOWNED") then
   local location=cf
   -- Un reset fuera de límites se recupera en un spawn validado del mapa.
   if maps.active then
    local bounds=maps.active.bounds;local v=bounds.CFrame:PointToObjectSpace(cf.Position);local half=bounds.Size/2
    if math.abs(v.X)>half.X or math.abs(v.Z)>half.Z or math.abs(v.Y)>half.Y then location=maps.active.survivors[1].cframe end
   end
   spawn:Teleport(player,location);health:Bind(player)
  else
   if core:IsActive() and p.status=="DOWNED" and not ok then core:Eliminate(id,nil,now()) end
   moveLobby(player)
  end
  recovery[id]=nil
 end)
end
health=require(script.Parent.HealthService).new(core,avatar,recoverCharacter)

local function message(player,text) if present(player) then remotes.Notice:FireClient(player,text) end end
local function selection(player,name)
 if type(name)~="string" or #name>40 or not table.find(registry.Order,name) then return end
 local model
 for _,item in lobby.CharacterGallery:GetChildren() do if item:GetAttribute("CharacterName")==name then model=item;break end end
 local surface=model and model:FindFirstChild("DisplaySurface",true)
 local character=player.Character;local rootPart=character and character:FindFirstChild("HumanoidRootPart")
 if not surface or not rootPart or (surface.Position-rootPart.Position).Magnitude>config.SelectionDistance then message(player,"Acércate al cuadro para elegir");return end
 local ok,text=core:Select(player.UserId,name)
 if ok then player:SetAttribute("BDPreference",name) end
 message(player,text)
end
for _,model in lobby.CharacterGallery:GetChildren() do
 local name=model:GetAttribute("CharacterName");local surface=model:FindFirstChild("DisplaySurface",true)
 if name and surface then
  local prompt=surface:FindFirstChild("BD_SelectCharacter")
  if not prompt then prompt=Instance.new("ProximityPrompt");prompt.Name="BD_SelectCharacter";prompt.Parent=surface end
  prompt.ActionText="Elegir superviviente";prompt.ObjectText=name;prompt.MaxActivationDistance=config.SelectionDistance
  prompt.RequiresLineOfSight=false;prompt.HoldDuration=.25
  prompt.Triggered:Connect(function(player) if limiter:Allow(player.UserId,now()) then selection(player,name) end end)
 end
end
local function snapshot()
 local roster={}
 for id,p in core.roster do
  table.insert(roster,{id=id,name=p.name,role=p.role,character=p.character,status=p.status,health=p.health,lives=p.lives,bleedoutAt=p.bleedoutAt})
 end
 table.sort(roster,function(a,b)return a.id<b.id end)
 return {state=core.state,roundId=core.roundId,deadline=core.deadline,serverNow=now(),roster=roster,
  countdownOnly=config.LobbyCountdownOnly,remainingSeconds=core:Remaining(now()),countdownId=core.countdownId,
  portalOpen=core.portalOpen,lmsSurvivorId=core.lmsSurvivorId,killerId=core.killerId,
  results=core.results,aggregate=core.aggregate,reason=core.reason,diagnostic=diagnostic,maxHealth=config.MaximumHealth,
  map=candidate and candidate.entry.Name or "MAPA NO DISPONIBLE"}
end
remotes.Request.OnServerEvent:Connect(function(player,action,value)
 if type(action)~="string" or #action>24 or not limiter:Allow(player.UserId,now()) then return end
 local time=now()
 if core:IsActive() and time>=core.deadline then core:Finish(time,"TIMEOUT") end
 if action=="Sync" then remotes.Snapshot:FireClient(player,snapshot())
 elseif action=="Select" then selection(player,value)
 elseif action=="ReviveBegin" and type(value)=="number" and value==value and value%1==0 then revive:Begin(player.UserId,value,time)
 elseif action=="ReviveCancel" then revive:Cancel(player.UserId) end
end)

local function updateBoards(players)
 local bestValue=-math.huge;local leaders={}
 for _,p in players do
  if p.malicia>bestValue then bestValue=p.malicia;leaders={p}
  elseif p.malicia==bestValue then table.insert(leaders,p) end
 end
 local record=core.killerId and core.roster[core.killerId]
 local picked=record and core.state~="WAITING_FOR_PLAYERS" and core.state~="INTERMISSION"
 local name=picked and record.name or (#leaders==1 and leaders[1].name or #leaders>1 and "EMPATE · "..#leaders.." JUGADORES" or "POR DETERMINAR")
 local id=picked and record.id or (#leaders==1 and leaders[1].id or 0)
 local score=0
 for _,p in players do if p.id==id then score=p.malicia end end
 if not picked and #leaders>1 then score=bestValue end
 local text=name.." · MALICIA "..tostring(score)
 if text~=lastBoard then
  lastBoard=text;lobbyState:SetAttribute("MaliciaValue",score);lobbyState:SetAttribute("MaliciaUserId",id);lobbyState:SetAttribute("MaliciaName",text)
 end
 API.SetCountdown(core:Remaining(now()))
 lobbyState:SetAttribute("RoundPhase",core.state)
 for _,model in lobby.CharacterGallery:GetChildren() do
  local display=model:FindFirstChild("DisplaySurface",true);display=display and display:FindFirstChild("Display")
  local name=model:GetAttribute("CharacterName")
  if display and name then
   local owner=nil
   for _,p in core.roster do if p.role=="SURVIVOR" and p.character==name then owner=p.name end end
   display.Detail.Text=owner and ("RESERVADO · "..owner) or "ELIGE EN EL CUADRO"
  end
 end
end

local function equipTestTool(player)
 if not RunService:IsStudio() or not config.StudioToolsEnabled then return end
 local backpack=player:FindFirstChildOfClass("Backpack");if not backpack then return end
 local tool=Instance.new("Tool");tool.Name="STUDIO · Daño de prueba";tool.RequiresHandle=false;tool.CanBeDropped=false
 local round=core.roundId;local nextHit=0
 tool.Activated:Connect(function()
  if not RunService:IsStudio() or core.roundId~=round or core.killerId~=player.UserId or not core:IsActive() or now()<nextHit then return end
  nextHit=now()+.8
  local actor=player.Character and player.Character:FindFirstChild("HumanoidRootPart");if not actor then return end
  local nearest,dist=nil,12
  for id,p in core.roster do
   local target=Players:GetPlayerByUserId(id);local targetRoot=target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
   if p.role=="SURVIVOR" and p.status=="ALIVE" and targetRoot then
    local delta=targetRoot.Position-actor.Position
    local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances={player.Character,target.Character};ray.RespectCanCollide=true
    if delta.Magnitude<dist and not workspace:Raycast(actor.Position,delta,ray) then nearest=target;dist=delta.Magnitude end
   end
  end
  if nearest then health:Damage(nearest,config.StudioDamage,player) end
 end)
 tool.Parent=backpack
end
local function removeTestTools(player)
 for _,container in {player:FindFirstChildOfClass("Backpack"),player.Character} do
  if container then for _,item in container:GetChildren() do if item:IsA("Tool") and item.Name=="STUDIO · Daño de prueba" then item:Destroy() end end end
 end
end

local function prepareRound()
 if preparing then return end;preparing=true
 local round=core.roundId
 task.spawn(function()
  local ok,err=xpcall(function()
   local active,problem=maps:Prepare(candidate)
   if not active then error(problem) end
   local survivors={};for _,p in core.roster do if p.role=="SURVIVOR" then table.insert(survivors,p) end end
   table.sort(survivors,function(a,b)return a.id<b.id end)
   local positions={[core.killerId]=active.killer.cframe}
   for i,p in survivors do positions[p.id]=active.survivors[i].cframe end
   local pending=0;local failure=nil
   for id,p in core.roster do
    local player=Players:GetPlayerByUserId(id)
    if player then
     avatar:Save(player);pending+=1
     task.spawn(function()
      local success,why=loadAvatar(player,p)
      if success and core.roundId==round and core.state=="PREPARING_ROUND" and core.roster[id]==p and present(player) then
       success,why=spawn:Teleport(player,positions[id])
       if success then health:Bind(player) end
      else success=false;why=why or "Preparación cancelada" end
      if not success then failure=why end
      pending-=1
     end)
    end
   end
   local untilTime=os.clock()+config.CharacterLoadTimeout+2
   repeat task.wait(.05) until pending==0 or os.clock()>=untilTime or core.state~="PREPARING_ROUND"
   if core.roundId~=round or core.state~="PREPARING_ROUND" then return end
   if pending>0 or failure then error(failure or "Tiempo agotado preparando participantes") end
   if core:StartRound(now()) then
    for id,p in core.roster do
     local player=Players:GetPlayerByUserId(id)
     if player then
      player:SetAttribute("BDRole",p.role);player:SetAttribute("BDCharacter",p.character);health:Sync(player)
      if p.role=="KILLER" then equipTestTool(player) end
     end
    end
   end
  end,function(e)return tostring(e).."\n"..debug.traceback()end)
  if not ok then
   warn("[BROKEN DREAMS] Preparación cancelada: "..tostring(err))
   diagnostic=tostring(err):match("^[^\n]+") or "Error preparando mapa"
   if core.roundId==round and core.state=="PREPARING_ROUND" then core:Abort(now(),"No se pudo preparar el mapa o los avatares") end
  end
  preparing=false
 end)
end
local function returnRound()
 if returning then return end;returning=true
 task.spawn(function()
  revive:Cleanup();escape:Cleanup();health:Cleanup()
  local ok,err=xpcall(function()
   local pending=0
   for index,player in Players:GetPlayers() do
    removeTestTools(player)
    if avatar.saved[player.UserId] then
     pending+=1
     task.spawn(function()
      controlledLoads[player.UserId]=true
      local restored=avatar:Restore(player)
      if not restored then loadAvatar(player,nil) end
      controlledLoads[player.UserId]=nil
      resetAttributes(player);moveLobby(player,index);pending-=1
     end)
    else resetAttributes(player);moveLobby(player,index) end
   end
   local stop=os.clock()+config.CharacterLoadTimeout+3
   repeat task.wait(.05) until pending==0 or os.clock()>=stop
  end,function(e)return tostring(e).."\n"..debug.traceback()end)
  if not ok then warn("[BROKEN DREAMS] Recuperación del lobby: "..err) end
  maps:Cleanup();outReturned={};candidate=nil;retryAt=now()+config.MapRetrySeconds
  core:Returned(now());returning=false
 end)
end

local function joined(player)
 player.RespawnLocation=lobby.PlayerSpawns.LobbySpawn
 local function characterAdded(character)
  local expected=controlledLoads[player.UserId]==true
  task.spawn(function()
   local rootPart=character:WaitForChild("HumanoidRootPart",10)
   if not rootPart or player.Character~=character or not present(player) or expected then return end
   local p=core.roster[player.UserId]
   if core:IsActive() and p and (p.status=="ALIVE" or p.status=="DOWNED") then
    recoverCharacter(player,rootPart.CFrame)
   else moveLobby(player) end
  end)
 end
 playerConnections[player.UserId]=player.CharacterAdded:Connect(characterAdded)
 if player.Character then characterAdded(player.Character) end
end
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
 core:Disconnect(player.UserId,now());health:Unbind(player.UserId);revive:Cancel(player.UserId)
 malicia:Forget(player);limiter:Forget(player.UserId)
 local connection=playerConnections[player.UserId];if connection then connection:Disconnect();playerConnections[player.UserId]=nil end
 avatar:Forget(player.UserId)
end)
for _,player in Players:GetPlayers() do joined(player) end

-- Única puerta de pruebas, solo servidor y creada exclusivamente dentro de Studio.
if RunService:IsStudio() and config.StudioToolsEnabled then
 local debugFunction=Instance.new("BindableFunction");debugFunction.Name="BrokenDreamsDebug";debugFunction.Parent=ServerStorage
 debugFunction.OnInvoke=function(command,userId,value)
  assert(RunService:IsStudio(),"Solo Studio")
  local player=type(userId)=="number" and Players:GetPlayerByUserId(userId) or nil
  if command=="Status" then return snapshot()
  elseif command=="Intermission" then assert(type(value)=="number" and value>=0 and value<=300);core.intermissionOverride=value;return true
  elseif command=="Start" then
   if #participantList()<config.MinimumPlayers or not candidate then return false,"Faltan jugadores o mapa válido" end
   if core.state=="WAITING_FOR_PLAYERS" then core:Step(now(),participantList(),true) end
   if core.state=="INTERMISSION" then core.deadline=now();return true end
   return false,"La ronda ya está en curso"
  elseif command=="Malicia" then assert(player,"Jugador no encontrado");malicia:SetStudio(player,value);return true
  elseif command=="Killer" then
   assert(player,"Jugador no encontrado");assert(core.state=="WAITING_FOR_PLAYERS" or core.state=="INTERMISSION","Configura antes de seleccionar")
   local maximum=0;for _,p in participantList() do maximum=math.max(maximum,p.malicia) end
   malicia:SetStudio(player,maximum+1);return true -- mantiene la regla de mayor Malicia
  elseif command=="Damage" or command=="Down" then
   assert(player,"Jugador no encontrado");return health:Damage(player,command=="Down" and config.MaximumHealth or value,Players:GetPlayerByUserId(core.killerId or 0))
  elseif command=="Revive" then assert(player,"Jugador no encontrado");return core:Revive(player.UserId,now())
  elseif command=="Escape" then if core:IsActive() then core.portalOpen=true;return true end;return false
  elseif command=="LMS" then return core:BeginLMS(now(),true)
  elseif command=="End" then return core:Finish(now(),"STUDIO_END")
  elseif command=="Time" then assert(core:IsActive() and type(value)=="number" and value>=0 and value<=600);core.deadline=now()+value;return true
  end
  return false,"Comando desconocido"
 end
end

local elapsed=0
RunService.Heartbeat:Connect(function(dt)
 elapsed+=dt;if elapsed<.1 then return end;elapsed=0
 if core.state=="WAITING_FOR_PLAYERS" and #Players:GetPlayers()==0 then return end
 local ok,err=xpcall(function()
  local time=now();local players=participantList()
  if not config.LobbyCountdownOnly and core.state=="WAITING_FOR_PLAYERS" and time>=retryAt and not preparing and not returning then
   candidate,diagnostic=maps:Next();diagnostic=diagnostic or "";retryAt=time+config.MapRetrySeconds
   API.SetNextMap(candidate and candidate.entry.Name or "MAPA NO DISPONIBLE",candidate and candidate.entry.Image or "")
  end
  core:Step(time,config.LobbyCountdownOnly and countdownRoster() or players,candidate~=nil)
  local request=core:TakeStartRequest()
  if request then
   -- Marcar antes de Fire: un consumidor puede reiniciar sin duplicar este evento.
   runtime:SetAttribute("LastStartRequestId",request.countdownId)
   runtime:SetAttribute("LastStartRequestAt",request.completedAt)
   startRequested:Fire(request.countdownId,request.completedAt)
   publishAt=0
  end
  if core.state=="PREPARING_ROUND" then prepareRound()
  elseif core:IsActive() then
   revive:Step(time)
   if core.portalOpen and maps.active then escape:Open(maps.active.escape) end
   escape:Step(time)
   for id,p in core.roster do
    local player=Players:GetPlayerByUserId(id)
    if player then
     health:Sync(player)
     if (p.status=="ESCAPED" or p.status=="ELIMINATED") and not outReturned[id] then
      outReturned[id]=true;moveLobby(player)
     end
    end
   end
  elseif core.state=="ROUND_RESULTS" then
   results:Deliver(core,Players);revive:Cleanup()
  elseif core.state=="RETURN_TO_LOBBY" then returnRound() end
  if core.state~=lastState or core.roundId~=lastRound then
   lastState=core.state;lastRound=core.roundId;publishAt=0
   if core.state=="ROUND_RESULTS" then
    for _,player in Players:GetPlayers() do removeTestTools(player);health:Sync(player) end
   end
  end
  if time>=publishAt then
   publishAt=time+.25;updateBoards(players)
   runtime:SetAttribute("Phase",core.state);runtime:SetAttribute("Deadline",core.deadline)
   runtime:SetAttribute("RoundId",core.roundId);runtime:SetAttribute("Diagnostic",diagnostic)
   remotes.Snapshot:FireAllClients(snapshot())
  end
 end,function(e)return tostring(e).."\n"..debug.traceback()end)
 if not ok then
  if lastWarning~=err then lastWarning=err;warn("[BROKEN DREAMS] "..err) end
  if core:IsActive() or core.state=="PREPARING_ROUND" or core.state=="CHARACTER_SELECTION" then core:Abort(now(),"Error recuperable del servidor") end
 end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5735">
        <Properties>
          <string name="Name">MapService</string>
          <string name="Source"><![CDATA[local Service={};Service.__index=Service
function Service.new(registry,spawn,config,lobby)
 return setmetatable({registry=registry,spawn=spawn,config=config,lobby=lobby,cursor=0,active=nil},Service)
end
function Service:Find(entry)
 local found={}
 local function ignored(o)
  local current=o
  while current do
   if current:GetAttribute("BD_IgnoreMapDiscovery") or current:GetAttribute("BD_RuntimeMap") then return true end
   current=current.Parent
  end
  return false
 end
 for _,service in {workspace,game:GetService("ServerStorage")} do
  for _,o in service:GetDescendants() do
   if o:IsA("Model") and (o:GetAttribute("BDMapId")==entry.Id or o.Name==entry.Name)
    and not o:IsDescendantOf(self.lobby) and o~=self.lobby and not ignored(o) then table.insert(found,o) end
  end
 end
 if #found==1 then return found[1] end
 return nil,#found==0 and "No está construido/importado "..entry.Name or "Hay modelos duplicados para "..entry.Name
end
function Service:Structure(model)
 local folder=model:FindFirstChild("RoundSpawns");local bounds=model:FindFirstChild("PlayBounds")
 if not folder or not bounds or not bounds:IsA("BasePart") or bounds.CanCollide or not bounds.Anchored then return nil,"Faltan RoundSpawns / PlayBounds válidos" end
 local killer=folder:FindFirstChild("Killer");local escape=folder:FindFirstChild("Escape")
 local survivors=folder:FindFirstChild("Survivors")
 if not killer or not escape or not survivors then return nil,"Faltan Killer, Escape o Survivors" end
 local list=survivors:GetChildren();table.sort(list,function(a,b)return a.Name<b.Name end)
 if #list<self.config.MaximumSurvivors then return nil,"Se necesitan seis marcadores de supervivientes" end
 for _,marker in list do if not marker:IsA("BasePart") then return nil,"Survivors solo debe contener marcadores Part" end end
 return {folder=folder,bounds=bounds,killer=killer,escape=escape,survivors=list}
end
function Service:Next()
 local available={};local problems={}
 for _,entry in self.registry do
  if entry.Enabled and (not entry.StudioOnly or game:GetService("RunService"):IsStudio()) then
   local model,err=self:Find(entry)
   if model then
    local structure;structure,err=self:Structure(model)
    if structure then table.insert(available,{entry=entry,model=model}) end
   end
   if err then table.insert(problems,err) end
  end
 end
 if #available==0 then return nil,table.concat(problems,"; ") end
 self.cursor=self.cursor%#available+1;return available[self.cursor]
end
function Service:Prepare(candidate)
 self:Cleanup()
 if not candidate or not candidate.model.Parent then return nil,"Mapa no disponible" end
 local map=candidate.model;local owned=false
 if map:IsDescendantOf(game:GetService("ServerStorage")) then
  map=map:Clone();map.Name="BD_ActiveMap";map:SetAttribute("BD_RuntimeMap",true);map.Parent=workspace;owned=true
  game:GetService("RunService").Heartbeat:Wait()
 end
 self.active={model=map,owned=owned}
 local s,err=self:Structure(map);if not s then self:Cleanup();return nil,err end
 local killer;killer,err=self.spawn:Validate(map,s.killer,s.bounds)
 if not killer then self:Cleanup();return nil,"Killer: "..err end
 local escape;escape,err=self.spawn:Validate(map,s.escape,s.bounds,Vector3.new(9,10,6))
 if not escape then self:Cleanup();return nil,"Escape: "..err end
 local survivors={}
 for i=1,self.config.MaximumSurvivors do
  local point;point,err=self.spawn:Validate(map,s.survivors[i],s.bounds)
  if not point then self:Cleanup();return nil,"Survivor "..i..": "..err end
  if (point.floor-killer.floor).Magnitude<self.config.MinimumKillerSpawnSeparation then self:Cleanup();return nil,"Asesino demasiado cerca de supervivientes" end
  for _,prior in survivors do if (point.floor-prior.floor).Magnitude<5 then self:Cleanup();return nil,"Spawns de supervivientes superpuestos" end end
  survivors[i]=point
 end
 self.active.killer=killer;self.active.escape=escape;self.active.survivors=survivors;self.active.bounds=s.bounds
 return self.active
end
function Service:Cleanup()
 if self.active and self.active.owned then self.active.model:Destroy() end
 self.active=nil
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5736">
        <Properties>
          <string name="Name">AvatarService</string>
          <string name="Source"><![CDATA[local Service={};Service.__index=Service
function Service.new(config,registry)
 return setmetatable({config=config,registry=registry,saved={},loading={}},Service)
end
function Service:Save(player)
 local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local root=c and c:FindFirstChild("HumanoidRootPart")
 if h and root and not self.saved[player.UserId] then
  local archivable=c.Archivable;c.Archivable=true
  local snapshot=c:Clone();c.Archivable=archivable
  self.saved[player.UserId]={WalkSpeed=h.WalkSpeed,JumpPower=h.JumpPower,JumpHeight=h.JumpHeight,
   AutoRotate=h.AutoRotate,UseJumpPower=h.UseJumpPower,MaxHealth=h.MaxHealth,Anchored=root.Anchored}
  self.saved[player.UserId].Snapshot=snapshot
 end
end
function Service:Load(player,record)
 if self.loading[player.UserId] then return false,"El avatar todavía está cargando" end
 self.loading[player.UserId]=true
 local done,ok,err=false,false,nil
 task.spawn(function()
  ok,err=pcall(function()
   local definition=record and (record.role=="KILLER" and self.registry.Killer or self.registry.Survivors[record.character])
   local modelName=definition and definition.ModelName or ""
   local temporaryTemplate=record and self.saved[player.UserId] and self.saved[player.UserId].Snapshot
   if modelName~="" or temporaryTemplate then
    local folder=game:GetService("ServerStorage"):FindFirstChild("BrokenDreamsCharacters")
    local template=temporaryTemplate
    if modelName~="" then template=folder and folder:FindFirstChild(modelName) end
    assert(template and template:FindFirstChildOfClass("Humanoid") and template:FindFirstChild("HumanoidRootPart"),"Modelo personalizado incompleto: "..modelName)
    local avatar=template:Clone();avatar.Name=player.Name
    local old=player.Character;player.Character=avatar;avatar.Parent=workspace
    if old then old:Destroy() end
   else player:LoadCharacterAsync() end
  end)
  self.loading[player.UserId]=nil;done=true
 end)
 local endAt=os.clock()+self.config.CharacterLoadTimeout
 repeat task.wait(.05) until done or not player.Parent or os.clock()>=endAt
 if not done then return false,"Tiempo agotado cargando avatar" end
 if not ok then return false,tostring(err) end
 local c=player.Character
 if not c or not c:FindFirstChildOfClass("Humanoid") or not c:FindFirstChild("HumanoidRootPart") then return false,"Avatar sin Humanoid / root" end
 if record and record.role=="KILLER" then
  local highlight=Instance.new("Highlight");highlight.Name="BD_KillerPlaceholder";highlight.FillColor=Color3.fromRGB(155,35,190)
  highlight.FillTransparency=.65;highlight.OutlineColor=Color3.fromRGB(255,65,65);highlight.DepthMode=Enum.HighlightDepthMode.Occluded;highlight.Parent=c
  local tag=Instance.new("BillboardGui");tag.Name="BD_RoleLabel";tag.Size=UDim2.fromOffset(160,36);tag.StudsOffset=Vector3.new(0,3,0);tag.MaxDistance=60;tag.Adornee=c.HumanoidRootPart;tag.Parent=c
  local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text="RAY.X · PROVISIONAL";label.TextColor3=Color3.fromRGB(255,100,130);label.TextScaled=true;label.Parent=tag
 end
 return true
end
function Service:Restore(player)
 local saved=self.saved[player.UserId]
 if not saved or not player.Parent then return false end
 if saved.Snapshot then
  local old=player.Character;local restored=saved.Snapshot;saved.Snapshot=nil
  restored.Name=player.Name;player.Character=restored;restored.Parent=workspace
  if old then old:Destroy() end
 end
 local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local root=c and c:FindFirstChild("HumanoidRootPart")
 if saved and h and root then
  for key,value in saved do if key~="Anchored" and key~="Snapshot" then h[key]=value end end
  root.Anchored=saved.Anchored;h.Health=h.MaxHealth
 end
 self.saved[player.UserId]=nil
 return h~=nil and root~=nil
end
function Service:Forget(id)
 local saved=self.saved[id]
 if saved and saved.Snapshot then saved.Snapshot:Destroy() end
 self.saved[id]=nil
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5737">
        <Properties>
          <string name="Name">MaliciaService</string>
          <string name="Source"><![CDATA[local Service={};Service.__index=Service
function Service.new(config,hooks)
 return setmetatable({config=config,hooks=hooks,values={},studioOverrides={}},Service)
end
function Service:Get(player)
 if self.studioOverrides[player.UserId]~=nil then return self.studioOverrides[player.UserId] end
 local value=self.hooks.ReadMalicia(player)
 if value==nil then
  if self.values[player.UserId]==nil then self.values[player.UserId]=self.config.InitialMalicia end
  value=self.values[player.UserId]
 end
 assert(type(value)=="number" and value==value and math.abs(value)<math.huge,"Malicia del servidor inválida")
 return value
end
function Service:SetStudio(player,value)
 assert(game:GetService("RunService"):IsStudio(),"Solo Studio")
 assert(type(value)=="number" and value==value and math.abs(value)<=1e9,"Valor inválido")
 self.studioOverrides[player.UserId]=value
end
function Service:Forget(player) self.values[player.UserId]=nil;self.studioOverrides[player.UserId]=nil end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5738">
        <Properties>
          <string name="Name">IntegrationHooks</string>
          <string name="Source"><![CDATA[-- Módulo SOLO servidor. Conectar aquí datos/economía existentes cuando se proporcionen.
-- No hay incremento, reinicio, premios ni almacenamiento inventados.
local Hooks={}
function Hooks.ReadMalicia(_player) return nil end -- nil usa GameConfig.InitialMalicia por sesión
function Hooks.OnResult(_player,_result,_roundKey)
 -- Una llamada por usuario/ronda en este servidor. Para guardar premios:
 -- usar UpdateAsync y deduplicar por roundKey ANTES de aplicar el premio.
end
return Hooks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5739">
        <Properties>
          <string name="Name">RoundCore</string>
          <string name="Source"><![CDATA[-- Núcleo puro: sin remotes, geometría ni reloj del cliente. now lo proporciona el servidor.
local Core = {}; Core.__index=Core
local function finite(n) return type(n)=="number" and n==n and math.abs(n)<math.huge end
function Core.new(config, characters, randomIndex)
 return setmetatable({config=config, characters=characters, randomIndex=randomIndex,
  state="WAITING_FOR_PLAYERS", deadline=0, roundId=0, revision=0, roster={},
  preferences={}, queue={}, sequence=0, results={}, reason="", mapReady=false,
  portalOpen=false, lmsUsed=false, killerId=nil, lastKiller={}, intermissionOverride=nil,
  countdownId=0, pendingStartRequest=nil},Core)
end
function Core:Change(state,now,duration)
 self.state=state; self.deadline=duration and now+duration or 0; self.revision+=1
end
function Core:IsActive() return self.state=="ACTIVE_ROUND" or self.state=="LAST_SURVIVOR_STANDING" end
function Core:IsLiveAt(now)
 if self:IsActive() and now>=self.deadline then self:Finish(now,"TIMEOUT");return false end
 return self:IsActive()
end
function Core:Remaining(now)
 if self.state=="ROUND_START_REQUESTED" then return 0 end
 return self.deadline==0 and -1 or math.max(0,math.ceil(self.deadline-now))
end
-- Consumo único: ni los Heartbeats siguientes ni un reinicio reemiten la misma señal.
function Core:TakeStartRequest()
 local request=self.pendingStartRequest;self.pendingStartRequest=nil;return request
end
function Core:RestartLobbyCountdown(now,players)
 if not self.config.LobbyCountdownOnly or (self.state~="WAITING_FOR_PLAYERS" and self.state~="INTERMISSION" and self.state~="ROUND_START_REQUESTED") then return false end
 self.pendingStartRequest=nil;self:Change("WAITING_FOR_PLAYERS",now)
 self:Step(now,players,false);return true
end
function Core:Candidates(players)
 local out={}
 for _,p in ipairs(players) do
  if finite(p.malicia) then
   if not self.queue[p.id] then self.sequence+=1; self.queue[p.id]=self.sequence end
   table.insert(out,p)
  end
 end
 table.sort(out,function(a,b) return self.queue[a.id]<self.queue[b.id] end)
 return out
end
function Core:ChooseKiller(players)
 local top=-math.huge; local tied={}
 for _,p in ipairs(players) do
  if p.malicia>top then top=p.malicia; tied={p}
  elseif p.malicia==top then table.insert(tied,p) end
 end
 -- Empate: quien menos recientemente fue asesino; azar uniforme si persiste.
 local oldest=math.huge; local finalists={}
 for _,p in ipairs(tied) do
  local last=self.lastKiller[p.id] or 0
  if last<oldest then oldest=last; finalists={p}
  elseif last==oldest then table.insert(finalists,p) end
 end
 return #finalists>0 and finalists[self.randomIndex(#finalists)] or nil
end
function Core:Select(id,name)
 if not table.find(self.characters,name) then return false,"Personaje desconocido" end
 if self.state=="WAITING_FOR_PLAYERS" or self.state=="INTERMISSION" then
  self.preferences[id]=name; self.revision+=1; return true,"Preferencia guardada"
 end
 if self.state~="CHARACTER_SELECTION" then return false,"Selección bloqueada" end
 local p=self.roster[id]
 if not p or p.role~="SURVIVOR" then return false,"Esperas la siguiente partida o eres RAY.X" end
 for otherId,other in pairs(self.roster) do
  if otherId~=id and other.character==name then return false,"Ese personaje ya está reservado" end
 end
 p.character=name; self.preferences[id]=name; self.revision+=1; return true,"Personaje reservado"
end
function Core:BeginSelection(players,now)
 local candidates=self:Candidates(players); local killer=self:ChooseKiller(candidates)
 if not killer or #candidates<self.config.MinimumPlayers then return end
 self.roundId+=1; self.killerId=killer.id; self.roster={}; self.results={}
 self.portalOpen=false; self.lmsUsed=false; self.lmsSurvivorId=nil; self.initialSurvivors=0; self.reason=""
 local function add(p,role)
  self.roster[p.id]={id=p.id,name=p.name,role=role,status="ALIVE",health=self.config.MaximumHealth,
   lives=role=="SURVIVOR" and 2 or 0, character=role=="KILLER" and "RAY.X" or nil}
 end
 add(killer,"KILLER")
 for _,p in ipairs(candidates) do
  if p.id~=killer.id and self.initialSurvivors<self.config.MaximumSurvivors then
   add(p,"SURVIVOR"); self.initialSurvivors+=1
  end
 end
 self:Change("CHARACTER_SELECTION",now,self.config.SelectionSeconds)
 -- Orden de cola para resolver preferencias repetidas sin duplicar personajes.
 for _,p in ipairs(candidates) do
  if self.preferences[p.id] then self:Select(p.id,self.preferences[p.id]) end
 end
end
function Core:FillCharacters()
 local used={}; local missing={}
 for _,p in pairs(self.roster) do
  if p.role=="SURVIVOR" then
   if p.character then used[p.character]=true else table.insert(missing,p) end
  end
 end
 table.sort(missing,function(a,b) return self.queue[a.id]<self.queue[b.id] end)
 for _,p in ipairs(missing) do
  for _,name in ipairs(self.characters) do if not used[name] then p.character=name; used[name]=true; break end end
 end
end
function Core:StartRound(now)
 if self.state~="PREPARING_ROUND" then return false end
 self.lastKiller[self.killerId]=self.roundId
 for id in pairs(self.roster) do self.sequence+=1; self.queue[id]=self.sequence end
 self:Change("ACTIVE_ROUND",now,self.config.RoundSeconds); return true
end
function Core:Abort(now,reason)
 self.reason=reason or "Ronda cancelada"; self.results={}
 for id in pairs(self.roster) do self.results[id]="CANCELLED" end
 self.aggregate="CANCELLED"; self:Change("ROUND_RESULTS",now,self.config.ResultsSeconds)
end
function Core:Survivors()
 local active={}
 for _,p in pairs(self.roster) do
  if p.role=="SURVIVOR" and (p.status=="ALIVE" or p.status=="DOWNED") then table.insert(active,p) end
 end
 return active
end
function Core:BeginLMS(now,manual)
 if not self:IsLiveAt(now) then return false end
 if self.state~="ACTIVE_ROUND" or self.lmsUsed then return false end
 local remaining=self:Survivors()
 if #remaining~=1 or remaining[1].status~="ALIVE" then return false end
 if not manual and self.initialSurvivors<2 then return false end
 self.lmsUsed=true; self.lmsSurvivorId=remaining[1].id
 self:Change("LAST_SURVIVOR_STANDING",now,self.config.LMSSeconds); return true
end
function Core:Finish(now,reason)
 if not self:IsActive() then return false end
 self.reason=reason; self.results={}; local escaped,failed=0,0
 for id,p in pairs(self.roster) do
  if p.role=="SURVIVOR" then
   local outcome
   if p.status=="ESCAPED" then outcome="ESCAPED"; escaped+=1
   elseif p.status=="ELIMINATED" or p.status=="DISCONNECTED" then outcome="DEFEAT"; failed+=1
   elseif reason=="KILLER_LEFT" and self.config.KillerDisconnectOutcome=="SURVIVOR_WIN" then outcome="SURVIVOR_WIN"
   elseif reason=="TIMEOUT" and self.config.TimeoutOutcome=="DRAW" then outcome="DRAW"
   elseif reason=="STUDIO_END" then outcome="CANCELLED"
   else outcome="DEFEAT"; failed+=1 end
   self.results[id]=outcome
  end
 end
 if reason=="STUDIO_END" then self.aggregate="CANCELLED"
 elseif reason=="KILLER_LEFT" then self.aggregate="KILLER_LEFT"
 elseif escaped>0 and failed>0 then self.aggregate="MIXED"
 elseif escaped>0 then self.aggregate="SURVIVOR_WIN"
 elseif reason=="TIMEOUT" and self.config.TimeoutOutcome=="DRAW" then self.aggregate="DRAW"
 else self.aggregate="KILLER_WIN" end
 self.results[self.killerId]=self.aggregate=="KILLER_WIN" and "KILLER_WIN"
  or self.aggregate=="CANCELLED" and "CANCELLED" or self.aggregate=="DRAW" and "DRAW" or "DEFEAT"
 self:Change("ROUND_RESULTS",now,self.config.ResultsSeconds); return true
end
function Core:Resolve(now)
 if not self:IsActive() then return end
 if #self:Survivors()==0 then self:Finish(now,"NO_SURVIVORS") else self:BeginLMS(now,false) end
end
function Core:Damage(id,amount,sourceId,now)
 if not self:IsLiveAt(now) or (sourceId~=nil and sourceId~=self.killerId) or not finite(amount) or amount<=0 then return false end
 local p=self.roster[id]
 if not p or p.role~="SURVIVOR" or p.status~="ALIVE" then return false end
 p.health=math.max(0,p.health-amount); self.revision+=1
 if p.health==0 then
  p.lives-=1
  if p.lives==1 then
   p.status="DOWNED"; p.downedBy=sourceId
   p.bleedoutAt=self.config.BleedoutSeconds and now+self.config.BleedoutSeconds or nil
  else self:Eliminate(id,sourceId,now) end
 end
 return true
end
function Core:Eliminate(id,sourceId,now)
 local p=self.roster[id]
 if not self:IsLiveAt(now) or not p or p.role~="SURVIVOR" or (p.status~="ALIVE" and p.status~="DOWNED") then return false end
 p.status="ELIMINATED";p.health=0;p.lives=0;p.bleedoutAt=nil;self.revision+=1
 if self.state=="ACTIVE_ROUND" and sourceId==self.killerId then self.deadline+=self.config.EliminationBonusSeconds end
 self:Resolve(now); return true
end
function Core:Revive(id,now)
 local p=self.roster[id]
 if not self:IsLiveAt(now) or not p or p.status~="DOWNED" then return false end
 if p.bleedoutAt and now>=p.bleedoutAt then return false end
 p.status="ALIVE";p.health=self.config.ReviveHealth;p.bleedoutAt=nil;self.revision+=1;return true
end
function Core:Escape(id,now)
 local p=self.roster[id]
 if not self:IsLiveAt(now) or not self.portalOpen or not p or p.role~="SURVIVOR" or p.status~="ALIVE" then return false end
 p.status="ESCAPED";self.revision+=1;self:Resolve(now);return true
end
function Core:Disconnect(id,now)
 self.preferences[id]=nil;self.queue[id]=nil
 local p=self.roster[id];if not p then return end
 if p.status~="ESCAPED" and p.status~="ELIMINATED" then p.status="DISCONNECTED" end
 self.revision+=1
 if self:IsActive() then
  if id==self.killerId then self:Finish(now,"KILLER_LEFT") else self:Resolve(now) end
 elseif self.state=="CHARACTER_SELECTION" or self.state=="PREPARING_ROUND" then
  if id==self.killerId or #self:Survivors()<1 then self:Abort(now,"Un participante salió durante la preparación")
  else self.roster[id]=nil;self.initialSurvivors-=1 end
 end
end
function Core:Returned(now)
 if self.state~="RETURN_TO_LOBBY" then return end
 self.roster={};self.killerId=nil;self.portalOpen=false;self.results={};self.reason=""
 self:Change("WAITING_FOR_PLAYERS",now)
end
function Core:Step(now,players,mapReady)
 self.mapReady=mapReady
 local canCount=self.config.LobbyCountdownOnly or mapReady
 if self.state=="WAITING_FOR_PLAYERS" then
  self:Candidates(players)
  if #players>=self.config.MinimumPlayers and canCount then
   self.countdownId+=1
   self.reason="";self:Change("INTERMISSION",now,self.intermissionOverride or self.config.IntermissionSeconds)
  end
 elseif self.state=="INTERMISSION" then
  if #players<self.config.MinimumPlayers or not canCount then self:Change("WAITING_FOR_PLAYERS",now)
  elseif now>=self.deadline then
   if self.config.LobbyCountdownOnly then
    self.pendingStartRequest={countdownId=self.countdownId,completedAt=now}
    self:Change("ROUND_START_REQUESTED",now)
   else self:BeginSelection(players,now) end
  end
 elseif self.state=="ROUND_START_REQUESTED" then
  if #players<self.config.MinimumPlayers then self:Change("WAITING_FOR_PLAYERS",now) end
 elseif self.state=="CHARACTER_SELECTION" then
  if #players<self.config.MinimumPlayers then self:Abort(now,"Faltan jugadores")
  elseif now>=self.deadline then self:FillCharacters();self:Change("PREPARING_ROUND",now) end
 elseif self:IsActive() then
  if now>=self.deadline then self:Finish(now,"TIMEOUT");return end
  if not self.portalOpen and self.deadline-now<=self.config.EscapeAtSeconds then self.portalOpen=true;self.revision+=1 end
  -- Resolver todos los sangrados del mismo tick antes de evaluar LMS.
  local expired={}
  for id,p in pairs(self.roster) do if p.status=="DOWNED" and p.bleedoutAt and now>=p.bleedoutAt then table.insert(expired,id) end end
  for _,id in ipairs(expired) do
   local p=self.roster[id]
   if self:IsActive() then self:Eliminate(id,p.downedBy,now) end
  end
  self:Resolve(now)
 elseif self.state=="ROUND_RESULTS" and now>=self.deadline then self:Change("RETURN_TO_LOBBY",now) end
end
return Core
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5740">
        <Properties>
          <string name="Name">EscapeService</string>
          <string name="Source"><![CDATA[local Service={};Service.__index=Service
function Service.new(core,players) return setmetatable({core=core,players=players,model=nil,trigger=nil},Service) end
function Service:Open(point)
 if self.model then return end
 local model=Instance.new("Model");model.Name="BD_EscapePainting"
 local origin=CFrame.lookAt(point.floor,point.floor+point.cframe.LookVector)
 local function part(name,size,offset,color,material)
  local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  p.Size=size;p.CFrame=origin*CFrame.new(offset);p.Color=color;p.Material=material or Enum.Material.Wood;p.Parent=model;return p
 end
 local gold=Color3.fromRGB(173,116,39)
 part("FrameLeft",Vector3.new(.65,9,.8),Vector3.new(-3.3,4.6,0),gold)
 part("FrameRight",Vector3.new(.65,9,.8),Vector3.new(3.3,4.6,0),gold)
 part("FrameTop",Vector3.new(7.3,.65,.8),Vector3.new(0,9,0),gold)
 part("FrameBottom",Vector3.new(7.3,.65,.8),Vector3.new(0,.3,0),gold)
 for _,x in {-3.3,3.3} do for _,y in {.3,9} do
  local ornament=part("CarvedCorner",Vector3.new(1.1,1.1,1.1),Vector3.new(x,y,0),gold,Enum.Material.Metal);ornament.Shape=Enum.PartType.Ball
 end end
 self.trigger=part("MagicCanvas",Vector3.new(6,8,.35),Vector3.new(0,4.6,0),Color3.fromRGB(147,64,224),Enum.Material.Neon)
 self.trigger.Transparency=.32
 local light=Instance.new("PointLight");light.Color=self.trigger.Color;light.Range=16;light.Brightness=1.4;light.Shadows=false;light.Parent=self.trigger
 local particles=Instance.new("ParticleEmitter");particles.Texture="rbxasset://textures/particles/sparkles_main.dds";particles.Rate=4
 particles.Lifetime=NumberRange.new(1,2);particles.Speed=NumberRange.new(.3,.8);particles.Size=NumberSequence.new(.18)
 particles.Color=ColorSequence.new(Color3.fromRGB(206,154,255));particles.LightEmission=.8;particles.Parent=self.trigger
 local gui=Instance.new("BillboardGui");gui.Size=UDim2.fromOffset(220,45);gui.StudsOffset=Vector3.new(0,5,0);gui.MaxDistance=140;gui.Parent=self.trigger
 local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text="EL CUADRO ESTÁ ABIERTO";label.TextColor3=Color3.fromRGB(239,210,255);label.TextScaled=true;label.Parent=gui
 model.Parent=workspace;self.model=model
end
function Service:Step(now)
 if not self.trigger or not self.core:IsActive() or now>=self.core.deadline then return end
 for id,p in self.core.roster do
  if p.role=="SURVIVOR" and p.status=="ALIVE" then
   local player=self.players:GetPlayerByUserId(id);local root=player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
   if root then
    local v=self.trigger.CFrame:PointToObjectSpace(root.Position)
    if math.abs(v.X)<=3 and math.abs(v.Y)<=4 and math.abs(v.Z)<=2.2 then self.core:Escape(id,now) end
   end
  end
 end
end
function Service:Cleanup() if self.model then self.model:Destroy() end;self.model=nil;self.trigger=nil end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5741">
        <Properties>
          <string name="Name">ReviveService</string>
          <string name="Source"><![CDATA[-- El cliente solo comunica empezar/cancelar. Nunca comunica cuánto tiempo mantuvo la acción.
local Service={};Service.__index=Service
function Service.new(core,config,players)
 return setmetatable({core=core,config=config,players=players,sessions={},prompts={}},Service)
end
function Service:Valid(actorId,targetId)
 if actorId==targetId or not self.core:IsActive() then return false end
 local a,b=self.core.roster[actorId],self.core.roster[targetId]
 if not a or not b or a.role~="SURVIVOR" or a.status~="ALIVE" or b.status~="DOWNED" then return false end
 local pa,pb=self.players:GetPlayerByUserId(actorId),self.players:GetPlayerByUserId(targetId)
 local ra=pa and pa.Character and pa.Character:FindFirstChild("HumanoidRootPart")
 local rb=pb and pb.Character and pb.Character:FindFirstChild("HumanoidRootPart")
 if not ra or not rb or (ra.Position-rb.Position).Magnitude>self.config.ReviveDistance then return false end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={pa.Character,pb.Character};params.RespectCanCollide=true
 if workspace:Raycast(ra.Position,rb.Position-ra.Position,params) then return false end
 return true
end
function Service:Begin(actorId,targetId,now)
 if self:Valid(actorId,targetId) then self.sessions[actorId]={target=targetId,started=now,round=self.core.roundId};return true end
 return false
end
function Service:Cancel(actorId) self.sessions[actorId]=nil end
function Service:Step(now)
 for actorId,s in self.sessions do
  if s.round~=self.core.roundId or not self:Valid(actorId,s.target) then self.sessions[actorId]=nil
  elseif now-s.started>=self.config.ReviveSeconds then self.core:Revive(s.target,now);self.sessions[actorId]=nil end
 end
 for id,p in self.core.roster do
  local player=self.players:GetPlayerByUserId(id)
  local root=player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local old=self.prompts[id]
  if old and (p.status~="DOWNED" or not self.core:IsActive() or old.Parent~=root) then old:Destroy();self.prompts[id]=nil end
  if p.status=="DOWNED" and self.core:IsActive() and root and not self.prompts[id] then
   local prompt=Instance.new("ProximityPrompt");prompt.Name="BD_Revive";prompt.ActionText="Reanimar";prompt.ObjectText=player.DisplayName
   prompt:SetAttribute("TargetUserId",id);prompt.HoldDuration=self.config.ReviveSeconds+.2;prompt.MaxActivationDistance=self.config.ReviveDistance;prompt.RequiresLineOfSight=true
   prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.Parent=root;self.prompts[id]=prompt
   -- La interacción se temporiza en Begin/Cancel a través del remote validado.
  end
 end
end
function Service:Cleanup()
 self.sessions={};for _,p in self.prompts do p:Destroy() end;self.prompts={}
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5742">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[local Service={};Service.__index=Service
function Service.new(config,lobby) return setmetatable({config=config,lobby=lobby},Service) end
function Service:Validate(map,marker,bounds,clearance)
 if not marker or not marker:IsA("BasePart") or not marker.Anchored or marker.CanCollide then return nil,"Marcador inválido o con colisión" end
 local p=bounds.CFrame:PointToObjectSpace(marker.Position)
 local half=bounds.Size/2
 if math.abs(p.X)>half.X-3 or math.abs(p.Z)>half.Z-3 or math.abs(p.Y)>half.Y then return nil,"Marcador fuera de PlayBounds" end
 local exclusions={map.RoundSpawns,bounds}
 local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
 local ignore=table.clone(exclusions)
 for _,pl in game:GetService("Players"):GetPlayers() do if pl.Character then table.insert(ignore,pl.Character) end end
 ray.FilterDescendantsInstances=ignore;ray.RespectCanCollide=true
 local hit=workspace:Raycast(marker.Position+Vector3.new(0,self.config.SpawnGroundRayHeight,0),
  Vector3.new(0,-self.config.SpawnGroundRayDepth,0),ray)
 if not hit or not hit.Instance:IsDescendantOf(map) or hit.Normal.Y<.8 then return nil,"Falta suelo seguro del mapa" end
 local floor=hit.Position
 -- Ningún spawn de partida puede invadir la carpa ni su bosque.
 local state=game:GetService("ReplicatedStorage"):FindFirstChild("BrokenDreamsLobbyState")
 if state then
  local origin=state:GetAttribute("Origin");local lo=state:GetAttribute("LobbyBoundsMin");local hi=state:GetAttribute("LobbyBoundsMax")
  if origin and lo and hi then
   local q=floor-origin
   if q.X>lo.X-8 and q.X<hi.X+8 and q.Z>lo.Z-8 and q.Z<hi.Z+8 then return nil,"El mapa invade el lobby" end
  end
 end
 local size=clearance or Vector3.new(unpack(self.config.SpawnClearance))
 -- Comprueba soporte bajo las cuatro esquinas, no solo un punto sobre un borde.
 for _,dx in {-size.X/2,size.X/2} do for _,dz in {-size.Z/2,size.Z/2} do
  local support=workspace:Raycast(floor+Vector3.new(dx,2,dz),Vector3.new(0,-4,0),ray)
  if not support or not support.Instance:IsDescendantOf(map) or support.Normal.Y<.8 or math.abs(support.Position.Y-floor.Y)>1 then return nil,"Suelo discontinuo junto al marcador" end
 end end
 local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude
 overlap.FilterDescendantsInstances=ignore;overlap.RespectCanCollide=true
 local cf=CFrame.new(floor+Vector3.new(0,size.Y/2+.15,0))
 for _,part in workspace:GetPartBoundsInBox(cf,size,overlap) do
  if part.CanCollide then return nil,"Volumen de aparición obstruido: "..part.Name end
 end
 local forward=marker.CFrame.LookVector*Vector3.new(1,0,1)
 if forward.Magnitude<.1 then forward=Vector3.new(0,0,-1) end
 return {floor=floor,cframe=CFrame.lookAt(floor+Vector3.new(0,3.5,0),floor+Vector3.new(0,3.5,0)+forward)}
end
function Service:Teleport(player,cf)
 local character=player.Character;local root=character and character:FindFirstChild("HumanoidRootPart")
 local hum=character and character:FindFirstChildOfClass("Humanoid")
 if not root or not hum or hum.Health<=0 then return false,"Avatar no disponible" end
 character:PivotTo(cf);root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
 return true
end
function Service:LobbyCFrame(index)
 local spawn=self.lobby.PlayerSpawns.LobbySpawn
 -- El acceso tiene espacio abierto; pequeños offsets evitan apilar avatares.
 return spawn.CFrame*CFrame.new(((index or 1)-1)%3*3-3,4,math.floor(((index or 1)-1)/3)*3)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5743">
        <Properties>
          <string name="Name">ResultsService</string>
          <string name="Source"><![CDATA[local Service={};Service.__index=Service
function Service.new(hooks) return setmetatable({hooks=hooks,processed={}},Service) end
function Service:Deliver(core,players)
 local key=game.JobId..":"..tostring(core.roundId)
 if self.processed[key] then return end
 self.processed={[key]=true} -- una sola ronda vigente, sin crecimiento ilimitado
 for id,result in core.results do
  local player=players:GetPlayerByUserId(id)
  if player then
   player:SetAttribute("BDResult",result)
   task.spawn(function()
    local ok,err=pcall(self.hooks.OnResult,player,result,key)
    if not ok then warn("[BROKEN DREAMS] Hook de resultados: "..tostring(err)) end
   end)
  end
 end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5744">
        <Properties>
          <string name="Name">HealthService</string>
          <string name="Source"><![CDATA[-- Fuente de salud: RoundCore en el servidor. Las habilidades futuras llaman Damage.
-- Humanoid se mantiene con >=1 durante DOWNED, sin depender de revivir un Humanoid muerto.
local Service={};Service.__index=Service
function Service.new(core,avatar,onDeath)
 return setmetatable({core=core,avatar=avatar,onDeath=onDeath,bindings={}},Service)
end
function Service:Unbind(id)
 local b=self.bindings[id];if b then for _,c in b.connections do c:Disconnect() end;self.bindings[id]=nil end
end
function Service:Bind(player)
 self:Unbind(player.UserId)
 local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local root=c and c:FindFirstChild("HumanoidRootPart")
 if not h or not root then return false end
 local b={connections={},writing=false,previous=self.core.config.MaximumHealth,root=root,humanoid=h,character=c};self.bindings[player.UserId]=b
 h.BreakJointsOnDeath=false
 -- El daño externo es ambiental: no puede fabricar una eliminación atribuida a RAY.X.
 table.insert(b.connections,h.HealthChanged:Connect(function(value)
  if b.writing or not self.core:IsActive() then return end
  local record=self.core.roster[player.UserId]
  if record and record.role=="SURVIVOR" and value<b.previous and record.status=="ALIVE" then
   self.core:Damage(player.UserId,b.previous-value,nil,workspace:GetServerTimeNow())
  end
  self:Sync(player)
 end))
 table.insert(b.connections,h.Died:Connect(function()
  if self.core:IsActive() then self.onDeath(player,root.CFrame) end
 end))
 self:Sync(player);return true
end
function Service:Sync(player)
 local p=self.core.roster[player.UserId];local b=self.bindings[player.UserId]
 if not b or not p or not b.character.Parent then return end
 local h,root=b.humanoid,b.root;local active=self.core:IsActive()
 local down=p.status=="DOWNED";local frozen=not active or down
 local out=p.status=="ELIMINATED" or p.status=="ESCAPED" or p.status=="DISCONNECTED"
 if out then frozen=false end
 local original=self.avatar.saved[player.UserId]
 local walk=original and original.WalkSpeed or 16
 local jump=original and original.JumpPower or 50
 local height=original and original.JumpHeight or 7.2
 h.WalkSpeed=frozen and 0 or walk;h.JumpPower=frozen and 0 or jump;h.JumpHeight=frozen and 0 or height;h.AutoRotate=not frozen
 root.Anchored=frozen
 if down then
  h.Sit=true
  if not b.character:FindFirstChild("BD_NeedsHelp") then
   local gui=Instance.new("BillboardGui");gui.Name="BD_NeedsHelp";gui.Size=UDim2.fromOffset(180,42);gui.StudsOffset=Vector3.new(0,3,0);gui.MaxDistance=90;gui.Adornee=root;gui.Parent=b.character
   local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.Text="NECESITA AYUDA";text.TextColor3=Color3.fromRGB(255,213,107);text.BackgroundTransparency=1;text.TextScaled=true;text.Parent=gui
  end
 else
  local help=b.character:FindFirstChild("BD_NeedsHelp");if help then help:Destroy();h.Sit=false end
 end
 b.writing=true
 h.MaxHealth=self.core.config.MaximumHealth
 local health=out and h.MaxHealth or math.max(1,p.health)
 if h.Health>0 and h.Health~=health then h.Health=health end
 b.previous=health;b.writing=false
 player:SetAttribute("BDHealth",p.health);player:SetAttribute("BDLives",p.lives);player:SetAttribute("BDStatus",p.status)
end
function Service:Damage(target,amount,killer)
 local now=workspace:GetServerTimeNow()
 -- Cierra primero la ronda si el plazo ya terminó.
 if self.core:IsActive() and now>=self.core.deadline then self.core:Finish(now,"TIMEOUT");return false end
 return self.core:Damage(target.UserId,amount,killer and killer.UserId or nil,now)
end
function Service:Cleanup()
 local ids={};for id in self.bindings do table.insert(ids,id) end
 for _,id in ids do self:Unbind(id) end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5745">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[local Limiter={};Limiter.__index=Limiter
function Limiter.new(capacity,refill) return setmetatable({capacity=capacity,refill=refill,buckets={}},Limiter) end
function Limiter:Allow(id,now)
 local b=self.buckets[id] or {tokens=self.capacity,time=now};self.buckets[id]=b
 b.tokens=math.min(self.capacity,b.tokens+math.max(0,now-b.time)*self.refill);b.time=now
 if b.tokens<1 then return false end;b.tokens-=1;return true
end
function Limiter:Forget(id) self.buckets[id]=nil end
return Limiter
]]></string>
        </Properties>
      </Item>
