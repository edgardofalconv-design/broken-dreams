          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="5729">
        <Properties>
          <string name="Name">RoundState</string>
          <BinaryString name="AttributesSerialize">AgAAAAgAAABEZWFkbGluZQUAAAAABQAAAFBoYXNlAhMAAABXQUlUSU5HX0ZPUl9QTEFZRVJT</BinaryString>
        </Properties>
