        <Properties>
          <string name="Name">Portraits</string>
          <BinaryString name="AttributesSerialize">BgAAAAcAAABCYXJiYXJhAgAAAAAGAAAAR2xvYm94AgAAAAANAAAAR3JhbmRfTWluaW11cwIAAAAAAgAAAEx5AgAAAAAFAAAATXVyZnkCAAAAAAYAAABSYXltYW4CAAAAAA==</BinaryString>
