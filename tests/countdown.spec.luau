local Core=require("../src/Server/RoundCore")
local Config=require("../src/Shared/GameConfig")
local Registry=require("../src/Shared/CharacterRegistry")
local formatTime=require("../src/Shared/TimerFormat")
local passed=0
local function test(name,fn)
 local ok,err=pcall(fn);assert(ok,name..": "..tostring(err));passed+=1;print("PASS "..name)
end
local one={{id=1,name="A",malicia=10}}
local two={one[1],{id=2,name="B",malicia=25}}
local function create()return Core.new(table.clone(Config),Registry.Order,function()return 1 end)end
test("Un jugador espera sin plazo ni evento",function()
 local c=create();c:Step(0,one,false);c:Step(100,one,false)
 assert(c.state=="WAITING_FOR_PLAYERS" and c:Remaining(100)==-1 and not c:TakeStartRequest())
end)
test("Dos jugadores inician 30 segundos aunque falte mapa",function()
 local c=create();c:Step(7,two,false)
 assert(c.state=="INTERMISSION" and c.deadline==37 and c:Remaining(7)==30)
end)
test("Ticks y jugadores adicionales no reinician ni duplican el reloj",function()
 local c=create();c:Step(7,two,false)
 local three=table.clone(two);table.insert(three,{id=3,name="C",malicia=6})
 for tick=8,20 do c:Step(tick,three,false) end
 assert(c.deadline==37 and c.countdownId==1 and c:Remaining(20)==17)
end)
test("Todos reciben el mismo entero de servidor y formato 00:09",function()
 local c=create();c:Step(0,two,false)
 for second=0,30 do
  local published=c:Remaining(second)
  local clientA=formatTime(published);local clientB=formatTime(published)
  assert(clientA==clientB)
 end
 assert(formatTime(c:Remaining(21))=="00:09")
 assert(formatTime(8)=="00:08" and formatTime(0)=="00:00" and formatTime(-1)=="—:—")
end)
test("Bajar de dos cancela y vuelve a empezar desde 30 al reunirse",function()
 local c=create();c:Step(0,two,false);c:Step(22,one,false)
 assert(c.state=="WAITING_FOR_PLAYERS" and not c:TakeStartRequest())
 c:Step(24,two,false);assert(c.deadline==54 and c:Remaining(24)==30 and c.countdownId==2)
end)
test("Abandono en el tick de cero cancela antes de emitir señal",function()
 local c=create();c:Step(0,two,false);c:Step(30,one,false)
 assert(c.state=="WAITING_FOR_PLAYERS" and not c:TakeStartRequest())
end)
test("Cero emite exactamente una solicitud interna y permanece visible",function()
 local c=create();c:Step(0,two,false);c:Step(30,two,false)
 local emitted=0
 for tick=30,100 do
  c:Step(tick,two,false)
  local request=c:TakeStartRequest()
  if request then emitted+=1;assert(request.countdownId==1 and request.completedAt==30) end
  assert(c:Remaining(tick)==0 and c.state=="ROUND_START_REQUESTED")
 end
 assert(emitted==1 and next(c.roster)==nil and c.roundId==0)
end)
test("Reiniciar desde cero crea un ciclo nuevo y otra única señal",function()
 local c=create();c:Step(0,two,false);c:Step(30,two,false);assert(c:TakeStartRequest())
 assert(c:RestartLobbyCountdown(35,two));assert(c:Remaining(35)==30)
 c:Step(65,two,false);assert(c:TakeStartRequest().countdownId==2);assert(not c:TakeStartRequest())
end)
test("Reinicio con un jugador espera, reinicio a mitad no deja señal vieja",function()
 local c=create();c:Step(0,two,false);c:RestartLobbyCountdown(10,two)
 c:Step(30,two,false);assert(not c:TakeStartRequest() and c:Remaining(30)==10)
 c:RestartLobbyCountdown(31,one);assert(c.state=="WAITING_FOR_PLAYERS")
end)
test("Malicia y elección de máximo permanecen intactas",function()
 local c=create();assert(c:ChooseKiller(two).id==2)
 c:Step(0,two,false);c:Step(30,two,false)
 assert(two[1].malicia==10 and two[2].malicia==25 and c:ChooseKiller(two).id==2 and c.killerId==nil)
end)
test("No se activa el ciclo de mapas aun existiendo arena provisional",function()
 local c=create();c:Step(0,two,true);c:Step(30,two,true);c:Step(500,two,true)
 assert(c.state=="ROUND_START_REQUESTED" and next(c.roster)==nil)
end)
print("TOTAL "..passed.." pruebas locales; sincronización de red y BindableEvent reales pendientes en Studio")
