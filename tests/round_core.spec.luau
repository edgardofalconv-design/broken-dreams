local Core=require("../src/Server/RoundCore")
local original=require("../src/Shared/GameConfig")
local registry=require("../src/Shared/CharacterRegistry")
local Limiter=require("../src/Server/RateLimiter")
local passed=0
local function test(name,run)
 local ok,err=pcall(run)
 if not ok then error("FAIL "..name..": "..tostring(err),0) end
 passed+=1;print("PASS "..name)
end
local function players(n)
 local t={};for i=1,n do table.insert(t,{id=i,name="Player"..i,malicia=i}) end;return t
end
local function create(n)
 local c=table.clone(original);c.LobbyCountdownOnly=false;local core=Core.new(c,registry.Order,function(_n)return 1 end)
 return core,players(n),c
end
local function active(n)
 local c,p,config=create(n);c:Step(0,p,true);c:Step(30,p,true);c:Step(45,p,true)
 assert(c.state=="PREPARING_ROUND");c:StartRound(45);return c,p,config
end
test("No empieza con un jugador",function()local c,p=create(1);c:Step(0,p,true);assert(c.state=="WAITING_FOR_PLAYERS")end)
test("Mapa ausente bloquea de forma segura",function()local c,p=create(3);c:Step(0,p,false);c:Step(999,p,false);assert(c.state=="WAITING_FOR_PLAYERS")end)
test("Intermedio automático de 30 y cancelación",function()
 local c,p=create(2);c:Step(10,p,true);assert(c.deadline==40);c:Step(20,{p[1]},true);assert(c.state=="WAITING_FOR_PLAYERS")
 c:Step(23,p,true);assert(c.deadline==53)
end)
test("Máxima Malicia estricta 10,25,6,15",function()
 local c,p=create(4);for i,v in {10,25,6,15} do p[i].malicia=v end
 c:Step(0,p,true);c:Step(30,p,true);assert(c.killerId==2)
end)
test("Desempate rota entre máximos, nunca incluye menor Malicia",function()
 local c,p=create(4);p[1].malicia=100;p[2].malicia=100;p[3].malicia=100;c.lastKiller[1]=4;c.lastKiller[2]=2
 assert(c:ChooseKiller(p).id==3);c.lastKiller[3]=5;assert(c:ChooseKiller(p).id==2)
end)
test("Azar de desempate solo entre empatados más antiguos",function()
 local c,p=create(3);p[1].malicia=20;p[2].malicia=20
 c.randomIndex=function(n)assert(n==2);return n end;assert(c:ChooseKiller(p).id==2)
end)
test("Capacidad seis sin excluir al máximo de Malicia",function()
 local c,p=create(10);c:Step(0,p,true);c:Step(30,p,true);assert(c.killerId==10)
 local survivors=0;for _,r in c.roster do if r.role=="SURVIVOR" then survivors+=1 end end
 assert(survivors==6 and not c.roster[7] and c.roster[10].character=="RAY.X")
end)
test("Preferencias no bloquean el lobby; reservas únicas por ronda",function()
 local c,p=create(4);assert(c:Select(1,"Rayman"));assert(c:Select(2,"Rayman"));c:Step(0,p,true);c:Step(30,p,true)
 assert(c.roster[1].character=="Rayman");assert(c.roster[2].character==nil)
 assert(not c:Select(2,"Rayman"));assert(c:Select(2,"Ly"));assert(not c:Select(4,"Barbara"))
 c:Step(45,p,true);local names={};for _,r in c.roster do if r.role=="SURVIVOR" then assert(r.character and not names[r.character]);names[r.character]=true end end
end)
test("Selección bloqueada en partida, 355 exactos",function()
 local c=active(4);assert(c:Remaining(45)==355 and c.deadline==400);assert(not c:Select(1,"Murfy"))
end)
test("Primera caída consume una vida; daño repetido no mata DOWNED",function()
 local c=active(4);assert(c:Damage(1,100,4,50));assert(c.roster[1].status=="DOWNED" and c.roster[1].lives==1)
 assert(not c:Damage(1,999,4,51));assert(c.deadline==400)
end)
test("Reanimación conserva vida gastada y salud configurada",function()
 local c=active(4);c:Damage(1,100,4,50);assert(c:Revive(1,54));assert(c.roster[1].health==50 and c.roster[1].lives==1)
 assert(not c:Revive(1,55))
end)
test("Segunda caída elimina y añade diez una sola vez",function()
 local c=active(4);c:Damage(1,100,4,50);c:Revive(1,54);c:Damage(1,50,4,60)
 assert(c.roster[1].status=="ELIMINATED" and c.deadline==410)
 assert(not c:Eliminate(1,4,61));assert(not c:Damage(1,100,4,61));assert(c.deadline==410)
end)
test("Daño ambiental no concede bonificación",function()
 local c=active(4);c:Damage(1,100,nil,50);c:Revive(1,54);c:Damage(1,100,nil,60);assert(c.deadline==400)
end)
test("No acepta daño NaN, infinito, negativo o atacante incorrecto",function()
 local c=active(4)
 for _,v in {0,-1,0/0,math.huge} do assert(not c:Damage(1,v,4,50)) end
 assert(not c:Damage(1,10,2,50));assert(c.roster[1].health==100)
end)
test("Escape abre a 80 y nunca permite asesino ni incapacitado",function()
 local c,p=active(4);c:Step(319,p,true);assert(not c.portalOpen);c:Step(320,p,true);assert(c.portalOpen)
 assert(not c:Escape(4,320));c:Damage(1,100,4,320);assert(not c:Escape(1,321))
 assert(c:Escape(2,321));assert(not c:Escape(2,322));assert(not c:Damage(2,100,4,322))
end)
test("Incapacitado cuenta: LMS no inicia con compañero reanimable",function()
 local c=active(3);c:Damage(1,100,3,50);c:Resolve(51);assert(c.state=="ACTIVE_ROUND")
end)
test("LMS exactamente 217, sin repetir, portal persiste",function()
 local c=active(3);c.portalOpen=true;c:Escape(1,55)
 assert(c.state=="LAST_SURVIVOR_STANDING" and c.deadline==272 and c.portalOpen and c.lmsSurvivorId==2)
 assert(not c:BeginLMS(56,true));assert(c.deadline==272)
end)
test("1v1 no fuerza LMS; activación manual disponible",function()
 local c,p=active(2);c:Step(46,p,true);assert(c.state=="ACTIVE_ROUND")
 assert(c:BeginLMS(50,true));assert(c.deadline==267)
end)
test("Salida LMS abre a 80",function()
 local c,p=active(2);c:BeginLMS(50,true);c:Step(186,p,true);assert(not c.portalOpen)
 c:Step(187,p,true);assert(c.portalOpen)
end)
test("LMS termina en escape sin duplicar resultado",function()
 local c=active(2);c:BeginLMS(50,true);c.portalOpen=true;assert(c:Escape(1,60));assert(c.state=="ROUND_RESULTS")
 assert(c.aggregate=="SURVIVOR_WIN" and c.results[1]=="ESCAPED");assert(not c:Finish(61,"TIMEOUT"))
end)
test("Resultado mixto cuando uno escapa y otro muere",function()
 local c=active(3);c.portalOpen=true;c:Escape(1,50);c:Damage(2,100,3,60);c:Revive(2,65);c:Damage(2,100,3,66)
 assert(c.aggregate=="MIXED" and c.results[1]=="ESCAPED" and c.results[2]=="DEFEAT")
end)
test("Timeout derrota provisional; retorno e intermedio siguiente",function()
 local c,p=active(3);c:Step(400,p,true);assert(c.state=="ROUND_RESULTS" and c.results[1]=="DEFEAT")
 c:Step(408,p,true);assert(c.state=="RETURN_TO_LOBBY");c:Returned(409);c:Step(410,p,true);assert(c.state=="INTERMISSION")
end)
test("Timeout configurable como empate",function()
 local c,p=active(3);c.config.TimeoutOutcome="DRAW";c:Step(400,p,true);assert(c.aggregate=="DRAW" and c.results[1]=="DRAW")
end)
test("Desconexión del asesino resuelve sin fingir escape",function()
 local c=active(3);c:Disconnect(3,50);assert(c.state=="ROUND_RESULTS" and c.results[1]=="SURVIVOR_WIN" and c.roster[1].status=="ALIVE")
end)
test("Desconexión incapacitado limpia y permite LMS",function()
 local c=active(3);c:Damage(1,100,3,50);c:Disconnect(1,51);assert(c.roster[1].status=="DISCONNECTED" and c.state=="LAST_SURVIVOR_STANDING")
end)
test("Todos los supervivientes abandonan: fin",function()
 local c=active(3);c:Disconnect(1,50);c:Disconnect(2,51);assert(c.state=="ROUND_RESULTS")
end)
test("Llegada tardía no entra al roster",function()
 local c,p=active(3);table.insert(p,{id=4,name="Late",malicia=999});c:Step(50,p,true);assert(not c.roster[4] and c.killerId==3)
end)
test("Asesino sale durante selección: cancelación",function()
 local c,p=create(3);c:Step(0,p,true);c:Step(30,p,true);c:Disconnect(3,31);assert(c.aggregate=="CANCELLED")
end)
test("Fallo de carga cancela sin empezar ronda",function()
 local c,p=create(3);c:Step(0,p,true);c:Step(30,p,true);c:Step(45,p,true);c:Abort(46,"mapa inseguro")
 assert(c.state=="ROUND_RESULTS" and c.results[1]=="CANCELLED");assert(not c:StartRound(47))
end)
test("Sangrado configurado resuelve DOWNED y solo bonifica una vez",function()
 local c,p=active(4);c:Damage(1,100,4,50);c:Step(95,p,true);assert(c.roster[1].status=="ELIMINATED" and c.deadline==410)
 c:Step(96,p,true);assert(c.deadline==410)
end)
test("Sangrado opcional y revive tardío rechazado",function()
 local c=active(3);c:Damage(1,100,3,50);assert(not c:Revive(1,95))
 c.config.BleedoutSeconds=false;c:Damage(2,100,3,51);assert(c.roster[2].bleedoutAt==nil)
end)
test("Cola da turno a excedentes en la ronda siguiente",function()
 local c,p=create(9);c:Step(0,p,true);c:Step(30,p,true);c:Step(45,p,true);c:StartRound(45)
 c:Finish(46,"STUDIO_END");c:Step(54,p,true);c:Returned(55);c:Step(56,p,true);c:Step(86,p,true)
 assert(c.roster[7] and c.roster[8] and c.killerId==9)
end)
test("Rate limit rechaza ráfagas y repone tokens",function()
 local l=Limiter.new(2,1);assert(l:Allow(1,0));assert(l:Allow(1,0));assert(not l:Allow(1,0));assert(l:Allow(1,1))
 l:Forget(1);assert(l:Allow(1,1))
end)
test("Servidor vacío vuelve a esperar sin iniciar rondas",function()
 local c=active(2);c:Disconnect(1,50);c:Disconnect(2,50);c:Step(58,{},false);c:Returned(59)
 for i=60,200 do c:Step(i,{},false) end;assert(c.state=="WAITING_FOR_PLAYERS")
end)
print("TOTAL "..passed.." pruebas de lógica pasadas; NO equivalen a Roblox Studio multicliente")
